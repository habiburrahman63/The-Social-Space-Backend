# Port the Backend API server listens on
PORT=3000

# MongoDB Database Connection URI
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/<db>?appName=Cluster0"

# Secret used to sign JWT session tokens. Change this in production.
JWT_SECRET="replace-with-a-long-random-string"

# SMTP Email Configuration for sending real verification codes
#
# IMPORTANT: Gmail's own SMTP (smtp.gmail.com) works for casual testing but
# is NOT reliable for automated/transactional email - Google's spam system
# frequently accepts the message (SMTP 250 OK) and then silently discards it
# before delivery, especially from new accounts or repeated similar emails.
# If verification emails aren't arriving even though your server logs show
# "accepted", this is almost always the cause - not a bug in this app.
#
# For production (and for trouble-free local testing), use a dedicated
# transactional email provider instead. No code changes are needed - only
# these five values change. Two good free-tier options:
#
#   Brevo (https://www.brevo.com):
#     SMTP_HOST="smtp-relay.brevo.com"
#     SMTP_PORT=587
#     SMTP_USER="your-brevo-login-email"
#     SMTP_PASS="your-brevo-smtp-key"        (Settings -> SMTP & API -> SMTP)
#     SMTP_FROM="Social Space <you@yourdomain-or-verified-sender.com>"
#
#   Resend (https://resend.com):
#     SMTP_HOST="smtp.resend.com"
#     SMTP_PORT=587
#     SMTP_USER="resend"
#     SMTP_PASS="your-resend-api-key"
#     SMTP_FROM="Social Space <onboarding@resend.dev>"   (or your verified domain)
#
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Social Space <your-email@gmail.com>"

# Comma-separated list of allowed Frontend origins for CORS.
# Use "*" during local development, or a specific list in production, e.g.:
# CORS_ORIGIN=http://localhost:5173,https://myapp.com
CORS_ORIGIN=*
